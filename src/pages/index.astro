---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import About from '../components/About.astro';
import Counts from '../components/Counts.astro';
import Services from '../components/Services.astro';
import AppointmentTiles from '../components/AppointmentTiles.astro';
import Departments from '../components/Departments.astro';
import Testimonials from '../components/Testimonials.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import Interactive from '../components/Interactive.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Header />
  <Hero />
  <main id="main">
    <Cta />
    <About />
    <Counts />
    <Services />
    <AppointmentTiles />
    <Departments />
    <Testimonials />
    <Gallery />
    <Faq />
    <Interactive />
    <Footer />
  </main>
</Layout>
